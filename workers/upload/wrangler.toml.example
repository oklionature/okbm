# romantic-upload-worker 설정 (2026-10-24 운영 값 기준: wrangler versions view로 확인)
# 복사해서 wrangler.toml로 쓰고, 저장소 밖 폴더에서 CLOUDFLARE_API_TOKEN을 뺀 채로 `npx wrangler deploy`.
# 비밀값 DELETE_SECRET은 대시보드에 있는 것을 그대로 쓴다(이 파일에 넣지 않음).

name = "romantic-upload-worker"
main = "worker.js"
compatibility_date = "2026-09-26"

[[r2_buckets]]
binding = "MY_BUCKET"
bucket_name = "romanticroute"

# 사진 지도용 작은 사본(thumb/<키>, 긴 변 480px)을 만든다
[images]
binding = "IMAGES"

[vars]
PUBLIC_BASE_URL = "https://pub-13ec7c39d2394ecc879bb2ed4b86a43c.r2.dev"
SUPABASE_URL = "https://qnumfecythtqtrxeasys.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_PKEidTwAKB7cuXReKSEnKw_VgNvSojA"
REQUIRE_AUTH = "true"

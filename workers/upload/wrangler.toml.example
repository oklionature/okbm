# romantic-upload-worker 설정 예시 (C1)
# 실제 배포 전 name / bucket_name을 Cloudflare 대시보드의 현재 값과 맞출 것.
# 복사해서 wrangler.toml로 쓰고 `npx wrangler deploy`로 배포.

name = "romantic-upload-worker"
main = "worker.js"
compatibility_date = "2026-09-01"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "<현재 R2 버킷 이름>"

[vars]
PUBLIC_BASE_URL = "https://pub-13ec7c39d2394ecc879bb2ed4b86a43c.r2.dev"
SUPABASE_URL = "https://qnumfecythtqtrxeasys.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_PKEidTwAKB7cuXReKSEnKw_VgNvSojA"
# 1단계(전환기) false → 클라이언트 OKBM_UPLOAD_SEND_AUTH=true 배포 후 → true
REQUIRE_AUTH = "false"

# 사용자/IP당 분당 30장
[[unsafe.bindings]]
name = "UPLOAD_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 30, period = 60 }
